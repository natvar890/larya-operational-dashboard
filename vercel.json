{
  "version": 2,
  "builds": [
    {
      "src": "api/weekly.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/monthly.js",
      "use": "@vercel/node"
    },
    {
      "src": "dashboard.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/weekly",
      "dest": "api/weekly.js"
    },
    {
      "src": "/api/monthly",
      "dest": "api/monthly.js"
    },
    {
      "src": "/dashboard",
      "dest": "dashboard.html"
    },
    {
      "src": "/",
      "dest": "dashboard.html"
    }
  ],
"crons": [
    {
      "path": "/api/weekly",
      "schedule": "0 12 * * 5"
    },
    {
      "path": "/api/monthly",
      "schedule": "0 12 1 * *"
    }
  ]
      "path": "/api/monthly",
      "schedule": "0 9 1 * ?"
    }
  ]
}
